# Copy to .env. .env is gitignored; never commit it.

# The RAG app's own vector-store database, created as a separate database
# (not schema) inside the same Postgres instance the gateway runs,
# see gateway/docker-compose.yml comment on the pgvector image swap.
# Ingestion connects with this URL (owner role).
RAGAPP_DATABASE_URL=postgresql://ragapp:CHANGEME@127.0.0.1:5432/ragapp

# The query path connects as ragapp_query: SELECT on chunks only, read-only
# transactions by default. A superuser creates the role by running
# rag-app/sql/roles.sql with RAGAPP_QUERY_PASSWORD set. chunks has row-level
# security: ragapp_query reads zero rows until each search switches to the
# caller's scope role (rag_scope_public/internal/restricted) with SET LOCAL
# ROLE. Re-run roles.sql after the first ingest and after any drop and
# re-creation of chunks, or the query path returns no documents.
RAGAPP_QUERY_DATABASE_URL=postgresql://ragapp_query:CHANGEME@127.0.0.1:5432/ragapp

# A virtual key from the gateway (never the master key), generate one with
# gateway/scripts/create-key.sh. End-user generations route through the
# gateway so they're authenticated, rate-limited, budgeted, and audit-logged
# like any other caller.
GATEWAY_VIRTUAL_KEY=sk-CHANGEME

OLLAMA_BASE_URL=http://127.0.0.1:11434
GATEWAY_BASE_URL=http://127.0.0.1:4000
EMBED_MODEL=nomic-embed-text
GUARDRAIL_MODEL=llama-guard3
GENERATION_MODEL=local-gemma
