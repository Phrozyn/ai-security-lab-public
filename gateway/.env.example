# Copy to .env and fill in values. .env is gitignored; never commit it.

# LiteLLM admin/master key: gates /key/generate, /key/update, /key/delete.
# Generate one, e.g.: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-CHANGEME-generate-with-openssl-rand-hex-32

# Salt used to encrypt stored virtual keys in Postgres. Set once, never rotate
# after keys exist; rotating it invalidates every issued virtual key.
LITELLM_SALT_KEY=CHANGEME-generate-with-openssl-rand-hex-32

# Postgres bootstrap superuser and the gateway database name. The Postgres container and
# administration use POSTGRES_USER; the litellm service does not receive POSTGRES_USER
# or POSTGRES_PASSWORD (docker-compose.yml lists litellm's variables one by one).
# A variable added to .env reaches litellm only when it is also listed there.
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=CHANGEME-generate-a-password

# Role the litellm service connects as: not a superuser, owns the gateway database
# (virtual keys, spend logs). A superuser creates it with gateway/sql/gateway-role.sql,
# run with GATEWAY_DB_PASSWORD set. Generate the password with: openssl rand -hex 24
GATEWAY_DB_USER=gateway_app
GATEWAY_DB_PASSWORD=CHANGEME-generate-a-password

# Where Ollama listens. The gateway runs with network_mode: host, so use the address
# Ollama binds on the host: 127.0.0.1 (default) or the host's private network address.
# Not host.docker.internal, which doesn't apply under host networking.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Gateway's own bind address/port on the host. Loopback by default.
# Widening it exposes the gateway beyond the host, so set it to a private
# network address, not 0.0.0.0.
LITELLM_BIND_ADDR=127.0.0.1
LITELLM_PORT=4000
