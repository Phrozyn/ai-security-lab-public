# Copy to .env. .env is gitignored; never commit it.

# The RAG app's own vector-store database, created as a separate database
# (not schema) inside the same Postgres instance the gateway runs,
# see gateway/docker-compose.yml comment on the pgvector image swap.
RAGAPP_DATABASE_URL=postgresql://ragapp:CHANGEME@127.0.0.1:5432/ragapp

# A virtual key from the gateway (never the master key), generate one with
# gateway/scripts/create-key.sh. End-user generations route through the
# gateway so they're authenticated, rate-limited, budgeted, and audit-logged
# like any other caller.
GATEWAY_VIRTUAL_KEY=sk-CHANGEME

OLLAMA_BASE_URL=http://127.0.0.1:11434
GATEWAY_BASE_URL=http://127.0.0.1:4000
EMBED_MODEL=nomic-embed-text
GUARDRAIL_MODEL=llama-guard3
GENERATION_MODEL=local-gemma
